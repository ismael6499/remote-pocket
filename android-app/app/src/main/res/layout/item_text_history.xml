<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_trackpad"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Timestamp + Session Badge + Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtItemTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/txtItemSessionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_rounded"
            android:backgroundTint="#2610B981"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/badge_this_session"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Text Body -->
    <TextView
        android:id="@+id/txtItemText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:maxLines="6"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="13sp" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemCopy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="📋 Copy"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/surface_card_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemResend"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/btn_resend_to_pc"
            android:textColor="@color/accent_emerald"
            android:textSize="11sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/accent_emerald" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemRestore"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="@color/accent_indigo"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/btn_restore_to_input"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="6dp" />
    </LinearLayout>

</LinearLayout>
