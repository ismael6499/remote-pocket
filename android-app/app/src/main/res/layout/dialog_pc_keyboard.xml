<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_dialog"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <!-- Switch to Standard Keyboard Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchToNormal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/btn_switch_normal_kb"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/surface_card_border" />

        <!-- Toggle Special Actions & F-Keys -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSpecial"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.2"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/toggle_special_keys"
            android:textColor="@color/accent_indigo"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/accent_indigo" />

        <!-- Quick Esc Button in Header -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscHeader"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_esc"
            android:textSize="10sp" />

        <!-- Close PC Keyboard (FAB button) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCloseKeyboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_keyboard"
            app:backgroundTint="@color/accent_indigo"
            app:fabCustomSize="32dp"
            app:maxImageSize="18dp"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Collapsible Special Actions & F-Keys Panel -->
    <LinearLayout
        android:id="@+id/layoutSpecialFunctions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_trackpad"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <!-- Special Shortcuts: Ctrl+C and Ctrl+V FIRST as requested by user! -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutCopy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_copy"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/accent_emerald" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutPaste"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_paste"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/accent_emerald" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutUndo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_undo"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutSelectAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_select_all"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutCut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_cut"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutSave"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_save_shortcut"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutAltTab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_alt_tab"
                    android:textColor="@color/accent_indigo"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_indigo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutWinD"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_win_d"
                    android:textColor="@color/accent_cyan"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutTaskMgr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_taskmgr"
                    android:textColor="@color/accent_coral"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_coral" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutWinL"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_win_l"
                    android:textColor="@color/accent_indigo"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_indigo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutCtrlAltDel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_ctrl_alt_del"
                    android:textColor="@color/accent_coral"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_coral" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Extended Nav Row (Ins, Del, Home, End, PgUp, PgDn, PrtScn) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIns"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Ins"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDel"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_del"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHome"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_home"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnd"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_end"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPgUp"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_pgup"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPgDn"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/btn_pgdn"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrtScn"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="PrtScn"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- F1 to F12 Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutFKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- WINDOWS TOUCH KEYBOARD (ESP / ENG ISO Layout)                 -->
    <!-- ============================================================= -->

    <!-- Row 1: Esc, º, 1, 2, 3, 4, 5, 6, 7, 8, 9, 0, ', ¡, Bksp (15 keys) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_esc"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="Esc"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_ord"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="º" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_1"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_2"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_3"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_4"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_5"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_6"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_7"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_8"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_9"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_0"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_quote"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="'" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_excl_open"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="¡" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_bksp"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.3"
            android:text="⌫"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 2: Tab, Q, W, E, R, T, Y, U, I, O, P, `, +, Enter (14 keys) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_tab"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.2"
            android:text="@string/btn_tab"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_q"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="Q"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_w"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="W"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_e"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="E"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_r"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="R"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_t"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="T"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_y"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="Y"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_u"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="U"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_i"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="I"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_o"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="O"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_p"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="P"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_grave"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="`" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_plus"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.0"
            android:text="+" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_enter"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.5"
            android:backgroundTint="@color/accent_indigo"
            android:text="@string/btn_enter"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Row 3: Caps, A, S, D, F, G, H, J, K, L, Ñ, ´, ç (13 keys) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_caps"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.3"
