<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_dialog"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <!-- Switch to Standard Keyboard Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchToNormal"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/btn_switch_normal_kb"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/surface_card_border" />

        <!-- Toggle Special Actions & F-Keys -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSpecial"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1.2"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/toggle_special_keys"
            android:textColor="@color/accent_indigo"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:strokeColor="@color/accent_indigo" />

        <!-- Quick Esc Button in Header -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscHeader"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_esc"
            android:textSize="10sp" />

        <!-- Close Dialog -->
        <ImageButton
            android:id="@+id/btnCloseKeyboard"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Collapsible Special Actions & F-Keys Panel -->
    <LinearLayout
        android:id="@+id/layoutSpecialFunctions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_trackpad"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Special Shortcuts (Ctrl+Alt+Del, Alt+Tab, Win+D, etc.) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutCtrlAltDel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_ctrl_alt_del"
                    android:textColor="@color/accent_coral"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_coral" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutAltTab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_alt_tab"
                    android:textColor="@color/accent_indigo"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_indigo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutWinD"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_win_d"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_emerald" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutTaskMgr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_taskmgr"
                    android:textColor="@color/accent_coral"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_coral" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutWinL"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_win_l"
                    android:textColor="@color/accent_indigo"
                    android:textSize="11sp"
                    app:strokeColor="@color/accent_indigo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutCopy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_copy"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShortcutPaste"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_paste"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:strokeColor="@color/surface_card_border" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Extended Nav Row (Ins, Del, Home, End, PgUp, PgDn, PrtScn) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIns"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Ins"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDel"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_del"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHome"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_home"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnd"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_end"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPgUp"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_pgup"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPgDn"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/btn_pgdn"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrtScn"
                    style="@style/Widget.RemotePocket.KeyButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="PrtScn"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- F1 to F12 Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutFKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- FULL STANDARD PC KEYBOARD (Always visible)                    -->
    <!-- ============================================================= -->

    <!-- Row 1: Numbers & Symbols (1 2 3 4 5 6 7 8 9 0 - = Bksp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_1"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_2"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_3"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_4"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_5"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_6"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_7"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="7" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_8"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_9"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="9" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_0"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_minus"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="-" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_equal"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="=" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_bksp"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1.6"
            android:text="⌫"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Row 2: Tab + Q W E R T Y U I O P [ ] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_tab"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.3"
            android:text="@string/btn_tab"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_q"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="Q"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_w"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="W"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_e"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="E"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_r"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="R"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_t"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="T"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_y"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="Y"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_u"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="U"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_i"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="I"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_o"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="O"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_p"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="P"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_bracket_left"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="[" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_bracket_right"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="]" />
    </LinearLayout>

    <!-- Row 3: Caps + A S D F G H J K L ; ' Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_caps"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.4"
            android:text="@string/btn_caps"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_a"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="A"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_s"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="S"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_d"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="D"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_f"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="F"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_g"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="G"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_h"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="H"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_j"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="J"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_k"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="K"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_l"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="L"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_nn"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="Ñ"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_semicolon"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text=";" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_quote"
            style="@style/Widget.RemotePocket.KeyButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:text="'" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_enter"
